# Enhanced MedID Biometric Service Environment Configuration
# Copy this to .env and configure with your actual values

# Security Configuration
BIOMETRIC_ENCRYPTION_KEY=your_32_character_base64_encryption_key_here
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# Database Configuration
DATABASE_URL=postgresql://medid_user:your_password@localhost:5432/medid_production

# Service Configuration
MIN_IMAGE_QUALITY=0.6
MIN_FACE_SIZE=120
MAX_IMAGE_SIZE=10485760
TEMPLATE_CACHE_SIZE=2000

# Logging Level
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Performance Settings
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379/0

# Production Security Headers
SECURE_HEADERS=true